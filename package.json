{
  "name": "astro-cn",
  "private": true,
  "version": "0.2.0",
  "description": "Astro 社区中文增强版：面向知识点、代码经验与错题的本地 Markdown 笔记和知识星图。",
  "license": "MIT",
  "homepage": "https://github.com/Cottins-Vanilla/Astro-CN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cottins-Vanilla/Astro-CN.git"
  },
  "bugs": {
    "url": "https://github.com/Cottins-Vanilla/Astro-CN/issues"
  },
  "keywords": [
    "knowledge-graph",
    "obsidian",
    "notes",
    "local-first",
    "electron",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @solen/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:paths": "node scripts/check-no-personal-paths.mjs",
    "licenses:bundle": "node scripts/collect-licenses.mjs",
    "build:windows": "pnpm build && pnpm licenses:bundle && pnpm --filter @solen/desktop exec electron-builder --win nsis --x64 --publish never",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0"
  }
}

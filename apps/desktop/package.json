{
  "name": "@solen/desktop",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p . && electron .",
    "start": "electron .",
    "pack": "tsc -p . && electron-builder --dir",
    "dist": "pnpm --filter @solen/core --filter @solen/plugin-api build && pnpm --filter @solen/web build && tsc -p . && electron-builder"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@solen/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "build": {
    "appId": "com.astro.zh.local",
    "productName": "Astro 中文版",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web-dist"
      },
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "../../LICENSE",
        "to": "licenses/LICENSE"
      },
      {
        "from": "../../THIRD-PARTY-NOTICES.md",
        "to": "licenses/THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "../../README.zh-CN.md",
        "to": "licenses/README.zh-CN.md"
      }
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "executableName": "Astro中文版",
      "signExecutable": false
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "artifactName": "Astro-CN-0.2.0-windows-x64-setup.${ext}",
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Astro 中文版",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "toolsets": {
      "nsis": "1.2.1"
    }
  },
  "description": "Astro 社区中文增强版：面向知识点、代码经验与错题的本地 Markdown 笔记和知识星图。",
  "author": "Astro CN community; based on Astro by Solen AI",
  "homepage": "https://github.com/Cottins-Vanilla/Astro-CN"
}
